#!/usr/bin/env bash

randomPort() {
	local port
	while true; do
		port=$(((RANDOM % 64512) + 1024))
		if ! (exec 3<>"/dev/tcp/127.0.0.1/${port}") 2>/dev/null; then
			echo "${port}"
			return
		fi
		exec 3>&-
	done
}

startServer() {
	sandpolis server --listen "127.0.0.1:$(randomPort)" --data . &

	# Wait for the realm cert
	until [ -s ./default.realm.pem ]; do
		sleep 0.1
	done
}

waitForAgent() {
	for _ in $(seq 30); do
		instance=$(sandpolis agents list --json --realm ./default.realm.pem |
			jq -r '.[0].instance_id // empty')
		if [ -n "${instance}" ]; then
			return
		fi
		sleep 1
	done
	false
}

## A fresh estate has no snapshots, and the list command must say so with an
## empty JSON array rather than an error.
testListReturnsEmptyJsonArray() {
	startServer
	sandpolis agent --realm ./default.realm.pem &
	waitForAgent

	sandpolis snapshot --json --realm ./default.realm.pem list | jq -e '. == []'
}
