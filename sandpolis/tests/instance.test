#!/usr/bin/env bash

randomPort() {
	local port
	while true; do
		port=$(((RANDOM % 64512) + 1024))
		if ! (exec 3<>"/dev/tcp/127.0.0.1/${port}") 2>/dev/null; then
			echo "${port}"
			return
		fi
		exec 3>&-
	done
}

## Test that a client can connect to a server.
testClientConnect() {
	port=$(randomPort)

	sandpolis server --listen "127.0.0.1:${port}" --data . &

	# Wait for the realm cert
	until [ -s ./default.realm.pem ]; do
		sleep 0.1
	done

	sandpolis servers --json --realm ./default.realm.pem
}

## Test that a agent can connect to a server.
testAgentConnect() {
	port=$(randomPort)

	sandpolis server --listen "127.0.0.1:${port}" --data . &

	# Wait for the realm cert
	until [ -s ./default.realm.pem ]; do
		sleep 0.1
	done

	sandpolis agent --realm ./default.realm.pem &

	sandpolis agents --json | jq -e .
}
